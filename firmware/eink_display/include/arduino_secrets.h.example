// Copy this file to arduino_secrets.h and fill in real values.
// arduino_secrets.h is git-ignored, so secrets never end up in the repo -
// same convention as the Python side's .env/.env.example (see the main
// README.md).
#pragma once

#define WIFI_SSID     "your-boat-wifi-ssid"
#define WIFI_PASSWORD "your-boat-wifi-password"

// The Pi's carpediem/web_server.py endpoint - see the main README.md's
// "Web server (data API)" section. Use the Pi's LAN IP/hostname (this
// device lives on the boat's own network and talks to the Pi directly,
// not via the remote data store the phone app uses), and WEBSERVER_PORT from
// whichever .env the Pi is actually running with (default 8080).
#define PI_API_URL "http://192.168.1.XXX:8080/api/data"

// Only if the Pi runs with WEBSERVER_API_KEY set in its .env - the same value.
// Leave this commented out when the Pi has no key (the default).
// #define PI_API_KEY "the-same-key-as-on-the-pi"
