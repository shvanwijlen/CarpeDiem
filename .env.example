# Copy this file to .env and fill in real values. .env is git-ignored, so
# secrets never end up in the repo. This replaces arduino_secrets_home.h /
# arduino_secrets.h from the Arduino version.

# ---- Feature toggles (equivalents of the old DoWiFi/DoBLE/DoMODBUS/... bools) ----
# When true, all boat-dependent subsystems below are skipped and the display
# data store is populated with fake values instead - for developing the
# screen/data layer away from the boat. Same purpose as the sketch's DoFake.
CARPEDIEM_DO_FAKE=true

CARPEDIEM_DO_MODBUS=true
CARPEDIEM_DO_MQTT=true
CARPEDIEM_DO_BLE=true
CARPEDIEM_DO_AIS=true
CARPEDIEM_DO_SHOW=true

# Optional peripherals - safe to leave both false on a Pi with no RTC/matrix
# wired up; the Pi's system clock (keep it NTP-synced) is used instead.
CARPEDIEM_USE_RTC=false
CARPEDIEM_USE_MATRIX=false

# ---- Victron Cerbo GX (Modbus TCP) ----
CERBO_HOST=192.168.1.228
CERBO_PORT=502

# ---- Venus OS / VRM MQTT ----
MQTT_HOST=venus.local
MQTT_PORT=1883
VRM_PORTAL_ID=c0619ab711a9

# ---- em-trak B954 AIS/GPS TCP stream ----
EMTRAK_HOST=192.168.2.1
EMTRAK_PORT=5000

# ---- Vessel name lookups (nearby AIS targets), via AISstream.io ----
# Free, no monthly quota - https://aisstream.io. Leave empty to run with
# MMSI-only labels and no name lookups.
AISSTREAM_API_KEY=a6cced8da4a0f4d42a1b7b2db903a815c04f20db

# ---- Logging ----
CARPEDIEM_LOG_DIR=./logs
CARPEDIEM_LOG_LEVEL=INFO
CARPEDIEM_LOG_MAX_BYTES=4194304
CARPEDIEM_LOG_BACKUP_COUNT=10
CARPEDIEM_LOG_RETENTION_DAYS=14
