# Copy this file to .env and fill in real values. .env is git-ignored, so
# secrets never end up in the repo. This replaces arduino_secrets_home.h /
# arduino_secrets.h from the Arduino version.

# ---- Feature toggles (equivalents of the old DoWiFi/DoBLE/DoMODBUS/... bools) ----
# When true, all boat-dependent subsystems below are skipped and the display
# data store is populated with fake values instead - for developing the
# screen/data layer away from the boat. Same purpose as the sketch's DoFake.
CARPEDIEM_DO_FAKE=true
CARPEDIEM_DO_MODBUS=true
CARPEDIEM_DO_MQTT=true
CARPEDIEM_DO_BLE=true
# How often the Bluetooth radio scans for the Teltonika Blue Pucks, and how
# long each scan window stays open - see README.md "Bluetooth (BLE) sensors".
# The gap between scans is speed-adaptive to save house-battery power: while
# underway (Speed above the threshold below) it polls every *_MOVING_*
# seconds; at rest (or before the first GPS/AIS fix) it polls only every
# *_STATIONARY_* seconds.
BLE_MOVING_POLL_INTERVAL_SECONDS=300
BLE_STATIONARY_POLL_INTERVAL_SECONDS=21600
BLE_MOVING_SPEED_THRESHOLD=1
BLE_SCAN_WINDOW_SECONDS=60
CARPEDIEM_DO_AIS=true
CARPEDIEM_DO_RING=true
CARPEDIEM_DO_WUNDERGROUND=true
CARPEDIEM_DO_SHOW=true

# Optional peripherals - safe to leave both false on a Pi with no RTC/matrix
# wired up; the Pi's system clock (keep it NTP-synced) is used instead.
CARPEDIEM_USE_RTC=false
CARPEDIEM_USE_MATRIX=true
# MAX7219 LED brightness, 0-100.
CARPEDIEM_MATRIX_BRIGHTNESS_PERCENT=10
# Real WiFi connectivity check for the status matrix's "WiFi" dot - see
# README.md "Status matrix (MAX7219)". Stays on even in fake mode.
CARPEDIEM_CHECK_WIFI=true

# CPU/memory/disk monitor for the HMI top bar's SYS indicator (the 8th/
# "spare" slot) - see sysmetrics_monitor.py. Green below *_WARN_PERCENT,
# orange up to *_CRIT_PERCENT, red at/above it; the LED shows the worst of
# the three. Every sample is also logged (level 9) with the exact
# CPU%/memory MB+%/disk GB+% numbers, not just the color.
CARPEDIEM_CHECK_SYSMETRICS=true
CARPEDIEM_SYSMETRICS_POLL_INTERVAL_SECONDS=10
CARPEDIEM_SYSMETRICS_DISK_PATH=/
CARPEDIEM_SYSMETRICS_CPU_WARN_PERCENT=60
CARPEDIEM_SYSMETRICS_CPU_CRIT_PERCENT=85
CARPEDIEM_SYSMETRICS_MEM_WARN_PERCENT=70
CARPEDIEM_SYSMETRICS_MEM_CRIT_PERCENT=90
CARPEDIEM_SYSMETRICS_DISK_WARN_PERCENT=80
CARPEDIEM_SYSMETRICS_DISK_CRIT_PERCENT=95
# The Pi's CPU temperature also feeds the SYS lamp (and is shown when you tap it).
# Raspberry Pi's documented limits: the CPU starts thermal-throttling at 80C and
# the GPU too from 85C, so 70 = getting close, 80 = throttling has started.
CARPEDIEM_SYSMETRICS_TEMP_WARN_C=70
CARPEDIEM_SYSMETRICS_TEMP_CRIT_C=80

# Magedok 1024x600 touchscreen HMI - leave false with no touchscreen wired
# up. See hmi/app.py.
#
# SDL needs to be told how to reach the display; which value depends on
# how the Pi boots:
# - Pi boots to its normal desktop (labwc/Wayland), and you start this app
#   yourself on top of it (our setup - CarpeDiem-PI, Sep 2026):
#     SDL_VIDEODRIVER=wayland
# - Pi boots straight to a console with no desktop running at all (a
#   dedicated kiosk, e.g. via `raspi-config` -> Boot / Auto Login ->
#   Console), so this app gets the display directly instead of drawing
#   inside someone else's compositor:
#     SDL_VIDEODRIVER=kmsdrm
# Either way this is a real (not carpediem-prefixed) env var, but it's
# fine to set here too - config.py's load_dotenv() populates real
# os.environ entries, and does so before pygame ever touches SDL.
SDL_VIDEODRIVER=wayland
CARPEDIEM_USE_HMI=true
CARPEDIEM_HMI_WIDTH=1024
CARPEDIEM_HMI_HEIGHT=600
CARPEDIEM_HMI_FULLSCREEN=true
CARPEDIEM_HMI_FPS=20
# "startrek" (default) renders with pygame - see hmi/app.py, SDL_VIDEODRIVER
# above. "StartrekGraphical" renders the same Main page with real
# QWidgets/QPainter via PySide6/Qt instead - see hmi_qt/app.py; needs
# `pip install PySide6` (not installed by default - see requirements.txt)
# and, same idea as SDL_VIDEODRIVER above, a Qt platform plugin:
# - Pi boots to its normal desktop and you start this app on top of it
#   (our setup - CarpeDiem-PI, Sep 2026): QT_QPA_PLATFORM=xcb - Qt's
#   native "wayland" QPA plugin left the window invisible under labwc
#   (fullscreen requests silently not honored - a labwc/Qt-wayland
#   interop gap, not our fullscreen code), xcb (i.e. via XWayland) works.
#   xcb needs two more things, neither carpediem-specific:
#     - `sudo apt install libxcb-cursor0` (Qt 6.5+'s xcb plugin hard-
#       requires it; without it Qt fails to load the plugin at all)
#     - DISPLAY set to wherever XWayland is actually listening - find it
#       with `ls /tmp/.X11-unix/` (a socket named X0 means DISPLAY=:0)
#       and set that below; an empty DISPLAY is "could not connect to
#       display" at startup.
# - Pi boots straight to a console with no desktop running at all:
#   QT_QPA_PLATFORM=eglfs (Qt owns the display directly via KMS/DRM).
CARPEDIEM_HMI_THEME=StartrekGraphical
QT_QPA_PLATFORM=xcb
DISPLAY=:0

# Geekworm X-UPS PLD (Power Loss Detection) shutdown monitor - leave false
# with no UPS wired up. See README.md "UPS power-loss shutdown".
CARPEDIEM_USE_UPS_MONITOR=false
UPS_PLD_GPIO_PIN=23
UPS_PLD_ACTIVE_HIGH=true
UPS_PLD_BOUNCE_SECONDS=0.2
# UPS_SHUTDOWN_SCRIPT=./scripts/pld_shutdown.sh

# Read-only JSON data API (GET /api/data) - see README.md "Web server
# (data API)". On by default; reachable from the boat's LAN and, via
# NordVPN Meshnet, remote devices too (an Arduino/e-ink display, an
# iPhone app). No authentication - see config.py's WebServerConfig.
CARPEDIEM_USE_WEBSERVER=true
WEBSERVER_HOST=0.0.0.0
WEBSERVER_PORT=8080

# BME280 environment sensor (temperature/humidity/pressure, I2C) - leave
# false with no BME280 wired up. See README.md "BME280 environment sensor".
CARPEDIEM_USE_BME280=false
# 119 = 0x77 (SDO floating/pulled high, the board's default), 118 = 0x76
# (SDO tied to GND).
BME280_I2C_ADDRESS=119
# Which /dev/i2c-N to open - 1 is the Pi's GPIO header bus (default). Only
# change this if `i2cdetect` finds the sensor on a different bus number
# (some Pis expose extra I2C buses for HDMI DDC/CEC alongside this one).
BME280_I2C_BUS=1
BME280_POLL_INTERVAL_SECONDS=30

# ---- Victron Cerbo GX (Modbus TCP) ----
CERBO_HOST=192.168.1.228
CERBO_PORT=502

# ---- Venus OS / VRM MQTT ----
MQTT_HOST=venus.local
MQTT_PORT=1883
VRM_PORTAL_ID=c0619ab711a9

# ---- em-trak B954 AIS/GPS TCP stream ----
EMTRAK_HOST=192.168.2.1
EMTRAK_PORT=5000

# ---- Vessel name lookups (nearby AIS targets), via AISstream.io ----
# Free, no monthly quota - https://aisstream.io. Leave empty to run with
# MMSI-only labels and no name lookups.
AISSTREAM_API_KEY=

# ---- Ring cameras (battery level) ----
# Run `python -m scripts.ring_auth_setup` once to authenticate (password +
# 2FA) and cache a refresh token to RING_TOKEN_FILE - after that, leave
# RING_USERNAME/RING_PASSWORD unset and only the cached token is used.
# RING_USERNAME=
# RING_PASSWORD=
RING_TOKEN_FILE=./ring_token.cache
RING_POLL_INTERVAL_SECONDS=600
# Must match the camera names exactly as shown in the Ring app.
RING_CAM_SALON_NAME=Salon
RING_CAM_BAKBOORD_NAME=Bakboord
RING_CAM_STUURBOORD_NAME=Stuurboord
RING_CAM_CONSOLE_NAME=Console
# Optional "live feed" tile on the Cam page: a still JPEG per camera,
# fetched on the same RING_POLL_INTERVAL_SECONDS cadence above. Off by
# default - a boat's internet is often metered, and this is a lot more
# data per poll than just the battery/connection status.
RING_FETCH_SNAPSHOTS=false
RING_SNAPSHOT_DIR=./ring_snapshots

# ---- Bresser 7-in-1 weather station (via Weather Underground) ----
# CARPEDIEM_DO_WUNDERGROUND above enables/disables this source; needs a
# free API key from your Wunderground account (Member Settings -> API
# Keys) and the Bresser gateway/app already uploading to Weather
# Underground (check its upload settings). A third source, reading back a
# ProWeatherLive public station page over HTTPS, was tried first and
# removed - this station's ProWeatherLive setup was never reliable enough.
WUNDERGROUND_STATION_ID=
WUNDERGROUND_API_KEY=
WUNDERGROUND_POLL_INTERVAL_SECONDS=300

# ---- Bresser 7-in-1 weather station (local RTL-SDR, via rtl_433) ----
# Alternative to the Weather Underground source above, for the same
# station - decodes its own 868.3MHz FSK broadcast directly via an RTL-SDR
# dongle + antenna and the rtl_433 binary (`sudo apt install rtl-433`), no
# cloud account needed. See README.md "Bresser weather station" and
# scripts/rtl433_sniff.py (confirm the dongle/antenna/rtl_433 install work
# at all before relying on this). Not forced off under CARPEDIEM_DO_FAKE -
# like CARPEDIEM_USE_BME280, it's local hardware, testable on the bench.
CARPEDIEM_USE_BRESSER_RTL=false
# Optional: rtl_433's decoded 'id' field for *this* station, so a
# neighboring identical-model Bresser 7-in-1 never gets mistaken for your
# own. 0 (default) accepts whichever Bresser-7in1 packet comes in.
BRESSER_RTL_STATION_ID=0

# ---- Wind direction recalibration (see README.md) ----
# Boat's own compass course while moored, at the moment the Bresser wind
# vane was physically calibrated/mounted - a one-time installation
# constant, not something to tune per-session. 259 is CDPI1's own value;
# change it only if the sensor gets physically remounted.
WIND_CALIBRATION_COURSE_DEG=259

# ---- Next bridge/lock (Main page banner) ----
# Rijkswaterstaat's public "Blauwe Golf, Verbindend" API - no key needed.
# Looks up whatever's ahead of the current Lat/Lng/Course (from GPS/AIS,
# or fake_data.py in fake mode) within range. min_range_km is the floor;
# the actual search radius also grows with current speed (lookahead_minutes
# worth of travel), so a faster boat looks further ahead.
VAARWEG_POLL_INTERVAL_SECONDS=30
VAARWEG_MIN_RANGE_KM=3
VAARWEG_LOOKAHEAD_MINUTES=30
VAARWEG_AHEAD_HALF_ANGLE_DEG=90
VAARWEG_LOCKS_CACHE_SECONDS=600

# ---- GPX track log (one file per run, startup to shutdown) ----
# Filename: "carpe diem_<YYYYMMDD>_<start HHMMSS>-<end HHMMSS>_<nearest
# city>.gpx" - city comes from one reverse-geocode lookup against
# OpenStreetMap's free Nominatim API (no key needed) at the first fix of
# the run. Stays on even in CARPEDIEM_DO_FAKE (see FeatureFlags'
# __post_init__ in config.py) so both the file-writing and the real
# geocoding call stay testable at a desk.
CARPEDIEM_DO_GPX_LOG=true
GPX_POLL_INTERVAL_SECONDS=10
GPX_MIN_POINTS_TO_WRITE=1
GPX_OUTPUT_DIR=./gpx_tracks

# ---- Logging ----
CARPEDIEM_LOG_DIR=./logs
CARPEDIEM_LOG_LEVEL=INFO
CARPEDIEM_LOG_MAX_BYTES=4194304
CARPEDIEM_LOG_BACKUP_COUNT=10
CARPEDIEM_LOG_RETENTION_DAYS=14
# Verbosity threshold for logging_setup.py's log(level, ...) calls
# throughout the codebase - separate from CARPEDIEM_LOG_LEVEL above, which
# only affects the standard logging module's own handler filtering. Raise
# to 10 temporarily to see every log(10, ...) debug line (e.g.
# ble_client.py's "BLE device found: name=...; address=..." for every
# single BLE detection, not just the ones that produce a reading).
CARPEDIEM_LOG_VERBOSITY=9
