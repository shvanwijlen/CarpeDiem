# Copy to .env (git-ignored) and fill in. Read by docker-compose.yml.

# Two different secrets. The Pi gets WRITE_API_KEY, the phone gets READ_API_KEY,
# so a lost phone can't be used to overwrite the boat's data. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
WRITE_API_KEY=
READ_API_KEY=

# Automatic cleanup of stored history:
#   -1  never delete anything
#   30  delete history older than 30 days (any whole number of days >= 1)
# The latest state and latest camera snapshots are never deleted, whatever this says.
RETENTION_DAYS=30
# How often the cleanup runs (it also runs once at startup).
CLEANUP_INTERVAL_MINUTES=60

# The Pi pushes every few seconds, but only one push per this many seconds is
# also kept as history (60 is roughly 10-15 MB/day). 0 = keep no history.
HISTORY_INTERVAL_SECONDS=60

# Which datastore: only "sqlite" (a file in ./data) exists so far.
STORAGE_BACKEND=sqlite
